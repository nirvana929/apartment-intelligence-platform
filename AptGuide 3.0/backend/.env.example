# =============================================================================
# AptGuide 3.0 — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in values before running the backend.
# All variables are prefixed with APTGUIDE3_ (see config.py).
# =============================================================================

# --- General ---
APTGUIDE3_ENVIRONMENT=local
APTGUIDE3_SERVICE_NAME=aptguide3

# --- LLM (DashScope / compatible OpenAI endpoint) ---
APTGUIDE3_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
APTGUIDE3_LLM_API_KEY=
APTGUIDE3_LLM_MODEL=qwen-turbo-latest

# --- Embedding Model ---
APTGUIDE3_EMBEDDING_BASE_URL=https://api.openai.com/v1
APTGUIDE3_EMBEDDING_API_KEY=
APTGUIDE3_EMBEDDING_MODEL=text-embedding-3-small

# --- Lease System (upstream property service) ---
APTGUIDE3_LEASE_BASE_URL=http://localhost:8081

# --- Vector Database (Milvus) ---
APTGUIDE3_VECTOR_URI=http://localhost:19530

# --- Auth ---
#   dev  = auto-authenticate as DEV_USER_ID (local development)
#   live = require valid auth tokens
APTGUIDE3_AUTH_MODE=dev
APTGUIDE3_DEV_USER_ID=dev-user-001
APTGUIDE3_INTERNAL_TOKEN=
APTGUIDE3_INTERNAL_TOKEN_REQUIRED=false

# --- MySQL ---
# Full DSN used by the backend (SQLAlchemy asyncmy driver).
# Format: mysql+asyncmy://<user>:<password>@<host>:<port>/<database>
# These individual vars are also used by scripts/apply_schema.py when
# APTGUIDE3_MYSQL_DSN is not set:
#   MYSQL_HOST, MYSQL_PORT, MYSQL_USER, MYSQL_PASSWORD, MYSQL_DATABASE
APTGUIDE3_MYSQL_DSN=mysql+asyncmy://root:change-me@localhost:3306/aptguide3

# --- Redis ---
APTGUIDE3_REDIS_URL=redis://localhost:6379/3
APTGUIDE3_REDIS_KEY_PREFIX=aptguide3
APTGUIDE3_SESSION_TTL_SECONDS=86400
APTGUIDE3_PENDING_ACTION_TTL_SECONDS=300

# --- CORS ---
APTGUIDE3_CORS_ALLOW_ORIGINS=http://localhost:5173

# --- Readiness probe timeout ---
APTGUIDE3_READINESS_TIMEOUT_SECONDS=2.0

# --- LangSmith tracing (optional, development only) ---
# When true, OpenAI-compatible LLM/embedding calls may be traced to LangSmith.
# Do not enable with production user data or secrets.
APTGUIDE3_LANGSMITH_TRACING=false
APTGUIDE3_LANGSMITH_PROJECT=aptguide3-local
APTGUIDE3_LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=

# --- Understanding diagnostics (local report fields) ---
APTGUIDE3_UNDERSTANDING_DIAGNOSTICS_ENABLED=false

# --- Docker Compose (docker-compose.local.yml) ---
# Set this before starting the local MySQL container:
#   MYSQL_ROOT_PASSWORD=change-me
