# AptGuide 2.0 Configuration

# --- Deployment ---
# local | staging | production
APTGUIDE_ENVIRONMENT=local
APTGUIDE_SERVICE_NAME=aptguide2
APTGUIDE_SERVICE_VERSION=0.1.0
# Comma-separated origins for CORS
APTGUIDE_CORS_ALLOW_ORIGINS=http://localhost:5173

# --- Observability ---
APTGUIDE_LOG_LEVEL=INFO
APTGUIDE_STRUCTURED_LOGS_ENABLED=true
APTGUIDE_EXPOSE_TRACE_TO_FRONTEND=true

# --- Milvus ---
APTGUIDE_MILVUS_URI=http://localhost:19530
APTGUIDE_MILVUS_TOKEN=

# --- Embedding (OpenAI-compatible) ---
APTGUIDE_EMBEDDING_API_KEY=sk-...
APTGUIDE_EMBEDDING_BASE_URL=https://api.openai.com/v1
APTGUIDE_EMBEDDING_MODEL=text-embedding-3-small
APTGUIDE_EMBEDDING_DIM=1536

# --- LLM (OpenAI-compatible) ---
APTGUIDE_LLM_API_KEY=sk-...
APTGUIDE_LLM_BASE_URL=https://api.openai.com/v1
APTGUIDE_LLM_MODEL=gpt-4o-mini

# --- Lease backend ---
APTGUIDE_LEASE_BASE_URL=http://localhost:8081
APTGUIDE_LEASE_TIMEOUT_SECONDS=5.0

# --- KB ---
APTGUIDE_KB_RULES_DIR=knowledge/rules

# --- Auth: dev | lease_token ---
# WARNING: dev mode is local-only. Use lease_token for staging/production.
APTGUIDE_AUTH_MODE=dev
APTGUIDE_DEV_USER_ID=dev-user-001
APTGUIDE_DEV_USER_NAME=本地测试用户
APTGUIDE_LEASE_USERINFO_PATH=/app/info

# --- Redis ---
APTGUIDE_REDIS_URL=redis://localhost:6379/0
APTGUIDE_REDIS_KEY_PREFIX=aptguide2
APTGUIDE_SESSION_TTL_SECONDS=86400
APTGUIDE_PENDING_ACTION_TTL_SECONDS=300

# --- MySQL ---
# WARNING: change credentials for staging/production.
APTGUIDE_MYSQL_DSN=mysql+asyncmy://root:change-me@localhost:3306/aptguide2

# --- Operator console ---
APTGUIDE_OPERATOR_CONSOLE_ENABLED=true
# WARNING: replace with a strong token for staging/production.
APTGUIDE_OPERATOR_DEV_TOKEN=operator-dev-token

# --- LangSmith observability ---
APTGUIDE_LANGSMITH_TRACING=false
APTGUIDE_LANGSMITH_ENDPOINT=https://api.smith.langchain.com
APTGUIDE_LANGSMITH_API_KEY=
APTGUIDE_LANGSMITH_PROJECT=aptguide2
APTGUIDE_LANGCHAIN_TRACING_V2=false
APTGUIDE_LANGCHAIN_API_KEY=
APTGUIDE_LANGCHAIN_PROJECT=aptguide2

# --- Langfuse observability ---
APTGUIDE_LANGFUSE_ENABLED=false
APTGUIDE_LANGFUSE_PUBLIC_KEY=
APTGUIDE_LANGFUSE_SECRET_KEY=
APTGUIDE_LANGFUSE_HOST=https://us.cloud.langfuse.com

# =============================================
# Staging/Production Example
# =============================================
# APTGUIDE_ENVIRONMENT=staging
# APTGUIDE_AUTH_MODE=lease_token
# APTGUIDE_CORS_ALLOW_ORIGINS=https://aptguide-staging.example.com
# APTGUIDE_LEASE_BASE_URL=http://lease-service:8081
# APTGUIDE_REDIS_URL=redis://redis:6379/0
# APTGUIDE_MYSQL_DSN=mysql+asyncmy://user:password@mysql:3306/aptguide2
# APTGUIDE_OPERATOR_CONSOLE_ENABLED=true
# APTGUIDE_OPERATOR_DEV_TOKEN=replace-with-strong-token
# APTGUIDE_STRUCTURED_LOGS_ENABLED=true
# APTGUIDE_EXPOSE_TRACE_TO_FRONTEND=true
