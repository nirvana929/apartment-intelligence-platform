APP_NAME=AptInsight
APP_ENV=local
LOG_LEVEL=INFO

LLM_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
LLM_API_KEY=replace-me
LLM_MODEL=mimo-v2.5-pro
LLM_TIMEOUT_SECONDS=30

MYSQL_HOST=192.168.211.128
MYSQL_PORT=3306
MYSQL_USER=chove
MYSQL_PASSWORD=replace-me
MYSQL_DATABASE=least
MYSQL_QUERY_TIMEOUT_SECONDS=10
MYSQL_MAX_ROWS=200

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

EXPOSE_SQL=true
ENABLE_QUERY_LOG=true

# LangSmith 可观测性（可选）
# 注册 https://smith.langchain.com 获取 API Key
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=replace-me
LANGSMITH_PROJECT=aptinsight
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=replace-me
LANGCHAIN_PROJECT=aptinsight
