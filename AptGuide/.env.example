# ===== AptGuide 环境变量示例 =====
# 复制为 .env 后填入真实值；.env 不应提交到仓库。

# --- 服务 ---
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8100
LOG_LEVEL=INFO

# --- LLM (OpenAI 兼容) ---
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=qwen-turbo-latest
LLM_TIMEOUT_SECONDS=30

# --- LangSmith tracing ---
# 测试时必须开启，用于记录 LangGraph / LLM / eval runner trace。
# 不要提交真实 LANGSMITH_API_KEY。
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=lsv2_pt_xxx
LANGSMITH_PROJECT=aptguide
# 兼容旧版 LangChain / LangSmith tracing 变量；值与 LANGSMITH_* 保持一致。
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_pt_xxx
LANGCHAIN_PROJECT=aptguide
# 如果 API key 绑定多个 workspace，再设置：
# LANGSMITH_WORKSPACE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# --- Embedding 模型 ---
# 本轮补测固定使用 text-embedding-v4；不要跟随 LLM_MODEL 切换。
# 如修改 EMBEDDING_MODEL，必须重建 Milvus KB / room 向量后再解释 retrieval 结果。
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=sk-xxx
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024

# --- Milvus ---
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=
MILVUS_DB=default
MILVUS_ROOM_COLLECTION=apt_room_vector
MILVUS_KB_COLLECTION=apt_rental_kb

# --- Java 后端工具接口 ---
LEASE_BASE_URL=http://127.0.0.1:8080
LEASE_INTERNAL_TOKEN=aptguide-internal-token-2026
LEASE_REQUEST_TIMEOUT_SECONDS=10

# --- 安全 ---
INTERNAL_API_KEY=replace-with-shared-secret
ALLOWED_ORIGINS=http://localhost:5173
